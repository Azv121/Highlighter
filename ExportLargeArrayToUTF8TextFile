Sub ExportLargeArrayToUTF8TextFile()
    Dim cell As Range
    Dim selectedRange As Range
    Dim outputString As String
    Dim wordCleaned As String
    Dim fileSavePath As Variant
    Dim utfStream As Object
    
    ' Check if selection is valid
    If Not TypeOf Selection Is Range Then
        MsgBox "Please select your list of words first.", vbExclamation
        Exit Sub
    End If
    
    Set selectedRange = Selection
    outputString = "["
    
    ' Loop through each cell safely
    For Each cell In selectedRange
        If Trim(cell.Value) <> "" Then
            wordCleaned = Trim(cell.Value)
            ' Strip trailing commas
            If Right(wordCleaned, 1) = "," Then
                wordCleaned = Left(wordCleaned, Len(wordCleaned) - 1)
            End If
            wordCleaned = Trim(wordCleaned)
            
            ' Append word with quotes
            outputString = outputString & """" & wordCleaned & """, "
        End If
    Next cell
    
    ' Clean up the trailing comma and space
    If Len(outputString) > 1 Then
        outputString = Left(outputString, Len(outputString) - 2)
    End If
    
    ' Close the bracket
    outputString = outputString & "]"
    
    ' Open Save As dialog box
    fileSavePath = Application.GetSaveAsFilename( _
        InitialFileName:="word_array.txt", _
        FileFilter:="Text Files (*.txt), *.txt, JSON Files (*.json), *.json", _
        Title:="Save Formatted Array As")
        
    ' Exit if user cancels
    If fileSavePath = False Then Exit Sub
    
    ' Create a UTF-8 ADODB Stream to handle Chinese characters safely
    On Error GoTo ErrorHandler
    Set utfStream = CreateObject("ADODB.Stream")
    With utfStream
        .Type = 2 ' Specify text data
        .Charset = "utf-8" ' Force UTF-8 Encoding
        .Open
        .WriteText outputString
        .SaveToFile fileSavePath, 2 ' Overwrite if file exists
        .Close
    End With
    
    MsgBox "Success! Your 10,000+ word array was saved with UTF-8 encoding to:" & vbCrLf & fileSavePath, vbInformation, "Export Complete"
    Exit Sub

ErrorHandler:
    MsgBox "An error occurred: " & Err.Description, vbCritical, "Error"
End Sub


